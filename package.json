{
  "name": "yayolauncher",
  "productName": "YayoLauncher",
  "author": "Yayo",
  "description": "Modded Minecraft Launcher",
  "homepage": "https://yayokorea.net",
  "bugs": {
    "url": "https://github.com/yayokorea/YayoLauncher/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yayokorea/YayoLauncher.git"
  },
  "private": true,
  "version": "5.0.2",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "vite",
    "build": "tsc && vite build",
    "release:win": "npm run build && electron-builder --win",
    "release:mac": "npm run build && electron-builder --mac",
    "release:lin": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "net.yayokorea.yayolauncher",
    "productName": "YayoLauncher",
    "copyright": "Copyright © 2026 Yayo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist",
      "dist-electron",
      "src/static/fonts/PRETENDARD-LICENSE.txt",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "publish": {
      "provider": "github",
      "owner": "yayokorea",
      "repo": "YayoLauncher"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YayoLauncher",
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "YayoLauncher"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "background": "build/background.png",
      "icon": "build/dmg-icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 430
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "Yayo",
      "vendor": "Yayo",
      "description": "Modded Minecraft Launcher",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "eml-lib": "^2.7.4",
    "marked": "^18.1.1",
    "skinview3d": "^3.4.2",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/dompurify": "^3.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  }
}
